provider "aws" {
  region = "us-east-2"
}

resource "aws_security_group" "instance" {
  name  = "terraform_example_instance"

  egress = [{
    cidr_blocks   = [ "0.0.0.0/0" ]
    ipv6_cidr_blocks = []
    prefix_list_ids   = []
    description   = ""
    from_port     = 0
    to_port       = 0
    protocol       = "-1"
    security_groups = []
    self          = false
    } ] 

  ingress {
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    ="tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_key_pair" "deployer" {
  key_name   = "aws_key"
  //algorithm = "RSA"
  public_key = "ssh-rsa blahblahblah user@example.com"
}

output "public_ip" {
  value       = aws_instance.terraform_example.public_ip
  description = "Public IP address of the instance"
}

resource "aws_instance" "terraform_example" {
  ami           = "ami-0c55b159cbfafe1f0"
  instance_type = "t2.micro"
  key_name      = "aws_key"

  vpc_security_group_ids = [aws_security_group.instance.id]

  user_data = <<-EOF
    #!/bin/bash
    echo "Hello there"  > index.html
    nohup busybox httpd -f -p 8080 &
  EOF

  tags = {
    Name = "terraform_example"
  }

  connection {
    type    = "ssh"
    host    = self.public_ip
    user    = "ubuntu"
    private_key = file("/home/user/.ssh/aws_key")
    timeout = "4m"
  }

}

